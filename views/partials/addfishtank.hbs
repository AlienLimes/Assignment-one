<form class="ui stacked segment form" action="/dashboard/addfishtank" method="POST" enctype="multipart/form-data">
  <h3 class="title-fishtank">Add Your Fishtank</h3>
  <div class="three fields">
  
    <div class="field">
      <label>Title</label>
      <input placeholder="Title" type="text" name="title" autofocus required>
    </div>

    <div class="field">
      <label>Rating</label>
      <input type="number" name="rating" min="1" max="5" placeholder="Rating" id="ratingNumber" required>
    </div>

    <div class="field">
      <label>Image</label>
      <input type="file" name="picture" required>
    </div>

  </div>

  <div style="text-align: center;">
  <button class="ui teal submit button">Add Fishtank</button>
</div>
</form>
