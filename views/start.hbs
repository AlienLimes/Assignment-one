{{> menu id="home"}}

<section class="ui center aligned middle aligned segment">


  <div class="aquarium">
    <h1 class="gradient-title">Welcome to Fish Tank App!</h1>

    <p class="home-line">
      Your personal aquarium management companion.
      <br> Track your tanks, monitor your fish and stay on top of essential maintenance.
      <br> All in one place.
    </p>






    <img src="/catFish.png" class="ui centered image" alt="Catfish illustration">

    <div style="margin-top: 32px;">
      <a href="/about" class="ui large yellow button animated-btn">

        Learn More About Us
      </a>
    </div>



    <div class="ui three statistics" style="margin-top: 4em;">

      {{#with info}}

      <div class="statistic">
        <div class="value">
          <i class="anchor icon"></i>
        </div>
        <div class="label">
          App Title: <br>
          <strong>{{appTitle}}</strong>
        </div>
      </div>



      <div class="statistic">
        <div class="value">
          <i class="map pin icon"></i>
        </div>
        <div class="label">
          Made in: <br>
          <strong>{{location}}</strong>
        </div>
      </div>

      <div class="statistic">
        <div class="value">
          <i class="smile outline icon"></i>
        </div>
        <div class="label">
          Created by: <br>
          <strong>{{creators.0.name}}</strong>
        </div>
      </div>



      {{/with}}

    </div>


  </div>


  <div class="circle bubble-1"></div>
  <div class="circle bubble-2"></div>
  <div class="circle bubble-3"></div>
  <div class="circle bubble-4"></div>
  <div class="circle bubble-5"></div>
  <div class="circle bubble-6"></div>
  <div class="circle bubble-7"></div>
  <div class="circle bubble-8"></div>



</section>
{{> footer}}